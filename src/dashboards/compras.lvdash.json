              {"name": "moneda_organismo", "query": {"datasetName": "organismo", "disaggregated": false, "fields": [{"name": "Moneda", "expression": "`Moneda`"}, {"name": "Moneda_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)"}]}},
