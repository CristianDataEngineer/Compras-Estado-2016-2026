{
  "datasets": [
    {
      "name": "total",
      "displayName": "Total por año",
      "query": "SELECT Ejercicio, Moneda, ordenes, monto_total\nFROM compras_estado.semantic.total_por_anio"
    },
    {
      "name": "organismo",
      "displayName": "Organismo",
      "query": "SELECT\n  Descripcion_SAF_orden,\n  Ejercicio,\n  Moneda,\n  COUNT(*) AS ordenes,\n  SUM(Monto) AS monto_total\nFROM compras_estado.semantic.ordenes\nGROUP BY Descripcion_SAF_orden, Ejercicio, Moneda"
    },
    {
      "name": "oficina",
      "displayName": "Oficina",
      "query": "SELECT\n  Descripcion_UOC_orden,\n  Ejercicio,\n  Moneda,\n  COUNT(*) AS ordenes,\n  SUM(Monto) AS monto_total\nFROM compras_estado.semantic.ordenes\nGROUP BY Descripcion_UOC_orden, Ejercicio, Moneda"
    },
    {
      "name": "proveedores",
      "displayName": "Proveedores",
      "query": "SELECT\n  CUIT,\n  Descripcion_Proveedor,\n  Ejercicio,\n  Moneda,\n  COUNT(*) AS ordenes,\n  COUNT(DISTINCT compra_id) AS compras,\n  SUM(Monto) AS monto_total\nFROM compras_estado.semantic.ordenes\nGROUP BY CUIT, Descripcion_Proveedor, Ejercicio, Moneda"
    },
    {
      "name": "rubros",
      "displayName": "Rubros",
      "query": "SELECT Ejercicio, Moneda, orden_id, rubro\nFROM (\n  SELECT\n    Ejercicio,\n    Moneda,\n    orden_id,\n    TRIM(rubro) AS rubro\n  FROM compras_estado.semantic.ordenes\n  LATERAL VIEW EXPLODE(SPLIT(Rubros, ';')) AS rubro\n)\nWHERE rubro <> ''"
    },
    {
      "name": "estimado",
      "displayName": "Estimado y adjudicado",
      "query": "SELECT\n  Numero_Proceso,\n  Nombre_del_Proceso,\n  Ejercicio,\n  Moneda,\n  Monto_Estimado,\n  SUM(Monto) AS monto_adjudicado,\n  COUNT(*) AS ordenes\nFROM compras_estado.semantic.ordenes\nWHERE compra_id IS NOT NULL\nGROUP BY Numero_Proceso, Nombre_del_Proceso, Ejercicio, Moneda, Monto_Estimado"
    }
  ],
  "pages": [
    {
      "name": "compras",
      "displayName": "Compras",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "position": {"x": 0, "y": 0, "width": 12, "height": 1},
          "widget": {
            "name": "titulo",
            "multilineTextboxSpec": {
              "lines": ["## Compras del Estado"]
            }
          }
        },
        {
          "position": {"x": 0, "y": 1, "width": 12, "height": 1},
          "widget": {
            "name": "subtitulo",
            "multilineTextboxSpec": {
              "lines": ["Pesos y dólares van aparte. Si no elegís un año, entra la fila sin año."]
            }
          }
        },
        {
          "position": {"x": 0, "y": 2, "width": 3, "height": 2},
          "widget": {
            "name": "filtro_anio",
            "queries": [
              {"name": "anio_total", "query": {"datasetName": "total", "disaggregated": false, "fields": [{"name": "Ejercicio", "expression": "`Ejercicio`"}, {"name": "Ejercicio_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)"}]}},
              {"name": "anio_organismo", "query": {"datasetName": "organismo", "disaggregated": false, "fields": [{"name": "Ejercicio", "expression": "`Ejercicio`"}, {"name": "Ejercicio_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)"}]}},
              {"name": "anio_oficina", "query": {"datasetName": "oficina", "disaggregated": false, "fields": [{"name": "Ejercicio", "expression": "`Ejercicio`"}, {"name": "Ejercicio_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)"}]}},
              {"name": "anio_proveedores", "query": {"datasetName": "proveedores", "disaggregated": false, "fields": [{"name": "Ejercicio", "expression": "`Ejercicio`"}, {"name": "Ejercicio_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)"}]}},
              {"name": "anio_rubros", "query": {"datasetName": "rubros", "disaggregated": false, "fields": [{"name": "Ejercicio", "expression": "`Ejercicio`"}, {"name": "Ejercicio_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)"}]}},
              {"name": "anio_estimado", "query": {"datasetName": "estimado", "disaggregated": false, "fields": [{"name": "Ejercicio", "expression": "`Ejercicio`"}, {"name": "Ejercicio_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)"}]}}
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {"fieldName": "Ejercicio", "displayName": "Año", "queryName": "anio_total"},
                  {"fieldName": "Ejercicio", "displayName": "Año", "queryName": "anio_organismo"},
                  {"fieldName": "Ejercicio", "displayName": "Año", "queryName": "anio_oficina"},
                  {"fieldName": "Ejercicio", "displayName": "Año", "queryName": "anio_proveedores"},
                  {"fieldName": "Ejercicio", "displayName": "Año", "queryName": "anio_rubros"},
                  {"fieldName": "Ejercicio", "displayName": "Año", "queryName": "anio_estimado"}
                ]
              },
              "frame": {"showTitle": true, "title": "Año"}
            }
